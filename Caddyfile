:8080 {
	root * /srv
	encode gzip zstd
	file_server

	# Vite fingerprints asset filenames, so they can be cached forever.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# The shell must never be cached, or a redeploy leaves clients requesting
	# bundles that no longer exist. Matches "/" too — that is how the site is
	# actually loaded, and a bare "/index.html" matcher would miss it.
	@shell path / /index.html
	header @shell Cache-Control "no-cache"

	log {
		output stdout
		format console
	}
}
